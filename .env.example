# Public site identity. Leave contact fields empty to hide them in the UI.
NEXT_PUBLIC_SITE_NAME="The Experts Hub Africa"
NEXT_PUBLIC_SITE_SHORT_NAME="TEHA"
NEXT_PUBLIC_BRAND_TAGLINE="TECH. INNOVATION. TRAVEL."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional published contact channels (do not invent values in code)
NEXT_PUBLIC_SITE_PHONE=""
NEXT_PUBLIC_SITE_EMAIL=""
NEXT_PUBLIC_SITE_ADDRESS=""
NEXT_PUBLIC_BUSINESS_HOURS=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""

# Neon PostgreSQL — required from Phase 2. Include ?sslmode=require.
# If DATABASE_URL uses the pooled host (-pooler), migrations may need DIRECT_URL
# pointing at the non-pooled connection instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Added in later phases — never commit real secrets
# AUTH_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional private object storage (required on Vercel — local disk is not writable there).
# Option A — Vercel Blob (recommended on Vercel): create a Blob store in the project Storage tab.
# BLOB_READ_WRITE_TOKEN=   # set automatically when a Blob store is connected
# BLOB_STORE_ID=           # set automatically when a Blob store is connected
#
# Option B — S3-compatible storage (R2, AWS S3, etc.):
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# RESEND_API_KEY=
# RESEND_FROM_EMAIL="The Experts Hub Africa <applications@example.com>"
# ADMIN_NOTIFICATION_EMAIL=
